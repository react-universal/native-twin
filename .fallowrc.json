{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/dev-tools/webui",
      "sites/twin.run",
      "!packages/ts-plugin/typescript-internals",
      "apps/*"
    ]
  },
  "duplicates": {
    "minOccurrences": 3,
    "ignore": [
      "**/build/**",
      "**/test/**",
      "**/tests/**",
      "**/__tests__/**",
      "**/__generated__/**"
    ]
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}