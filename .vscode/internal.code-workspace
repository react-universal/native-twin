      "path": "../apps/docs-site"
    },
    {
      "name": "expo-app",
      "path": "../apps/expo-app"
    }
  ],
  "settings": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    },
    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/.turbo": true,
      "**/.fallow": true,
      "**/.nx": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true
    },
    "biome.suggestInstallingGlobally": true,
    "editor.snippetSuggestions": "bottom",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "search.exclude": {
      "**/node_modules/**": true,
      "**/*.code-search": true,
      "**/build/**": true
    },
    "js/ts.tsdk.path": "✨ native-twin/node_modules/typescript/lib",
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    },
    "[json]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[typescript]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "cSpell.ignoreRandomStrings": true,
    "cSpell.unknownWords": "report-common-typos",
    "terminal.integrated.suggest.enabled": true,
    "terminal.integrated.suggest.quickSuggestions": {
      "commands": "on",
      "arguments": "on",
      "unknown": "off"
    },
    "chat.disableAIFeatures": true,
    "terminal.integrated.suggest.providers": {
      "lsp": true
    },
    "fallow.configPath": "./.fallowrc.json",
    "[jsonc]": {
      "editor.defaultFormatter": "biomejs.biome"
    }
  }
}