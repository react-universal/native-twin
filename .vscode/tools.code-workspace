{
  "folders": [
    {
      "name": "✨ native-twin",
      "path": ".."
    },
    {
      "name": "📦 @native-twin/language-service",
      "path": "../packages/language-service"
    },
    {
      "name": "📦 @native-twin/language-server",
      "path": "../packages/language-server"
    },
    {
      "name": "📦 native-twin-vscode",
      "path": "../packages/vscode-extension"
    },
    {
      "name": "📦 @native-twin/adapters",
      "path": "../packages/adapters"
    },
    {
      "name": "📦 @native-twin/cli",
      "path": "../packages/builder"
    },
    {
      "name": "📦 @native-twin/compiler",
      "path": "../packages/compiler"
    },
    {
      "name": "📦 @native-twin/css",
      "path": "../packages/css"
    },
    {
      "name": "📦 @native-twin/data-types",
      "path": "../packages/data-types"
    },
    {
      "name": "📦 @native-twin/helpers",
      "path": "../packages/helpers"
    },
    {
      "name": "ts-plugin",
      "path": "../packages/ts-plugin"
    },
    {
      "name": "📦 @native-twin/core",
      "path": "../packages/native-twin"
    },
    {
      "name": "📦 @native-twin/preset-tailwind",
      "path": "../packages/preset-tailwind"
    },
    {
      "name": "📦 @native-twin/vite-plugin",
      "path": "../packages/vite-plugin"
    },
    {
      "name": "twin-run",
      "path": "../sites/twin.run"
    },
    {
      "name": "🚀 expo-app",
      "path": "../apps/expo-app"
    }
  ],
  "settings": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    },
    "export-typescript.excludes": [
      "**/*.{ts,tsx,spec.ts,spec.tsx}"
    ],
    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
      ".turbo": true,
      "**/CHANGELOG.md": true,
      "**/jest.config.js": false,
      "**/LICENSE": true,
      "**/babel.config.js": false,
      "**/build": false,
      "**/turbo.json": false,
      "**/.eslintrc.json": false,
      "**/.eslintignore": true,
      "**/README.md": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/*.code-search": true,
      "**/build": true,
      "**/dist": true
    },
    "editor.fontSize": 16,
    "cSpell.words": [
      "sastan",
      "TRBL",
      "xytrbl"
    ],
    "jest.enable": false,
    "jest.runMode": "on-demand",
    "jest.debugMode": false,
    "jest.disabledWorkspaceFolders": [
      "root",
      "📦 @lib/builder",
      "📦 @lib/with-nextjs",
      "📦 @lib/vscode",
      "📦 @lib/vite-plugin",
      "📦 @lib/language-service",
      "📦 @lib/language-server",
      "expo-app",
      "next-pages-example",
      "next-app-dir",
      "docs-site",
      "twin.run"
    ],
    "findUnusedExports.detectCircularImports": true
  }
}