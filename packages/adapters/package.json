{
  "name": "@native-twin/adapters",
  "version": "7.0.0-next.3",
  "description": "React Native Web Tailwindcss for nextjs",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "tailwind-native",
    "react-native-web",
    "universal-labs",
    "react-native",
    "react",
    "nextjs"
  ],
  "exports": {
    "./next/_app.js": {
      "types": "./build/dts/next/_app.d.ts",
      "import": "./build/esm/next/_app.js",
      "require": "./build/cjs/next/_app.js"
    },
    "./next/_document.js": {
      "types": "./build/dts/next/_document.d.ts",
      "import": "./build/esm/next/_document.js",
      "require": "./build/cjs/next/_document.js"
    },
    "./next/app": {
      "types": "./build/dts/next/app/index.d.ts",
      "import": "./build/esm/next/app/index.js",
      "require": "./build/cjs/next/app/index.js"
    }
  },
  "homepage": "https://github.com/react-universal/native-twin#readme",
  "bugs": {
    "url": "https://github.com/react-universal/native-twin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-universal/native-twin",
    "directory": "packages/adapters"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "build",
    "src",
    "app",
    "_app",
    "_document",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf build",
    "build": "npx tsdown",
    "lint": "biome lint"
  },
  "devDependencies": {
    "@native-twin/core": "workspace:*",
    "@native-twin/css": "workspace:*",
    "@native-twin/helpers": "workspace:*"
  },
  "peerDependencies": {
    "@native-twin/core": "workspace:*",
    "@native-twin/css": "workspace:*",
    "@native-twin/helpers": "workspace:*",
    "next": "^14.2.3",
    "react": "18.3.1"
  },
  "optionalDependencies": {
    "@native-twin/cli": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
