{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": [
        "$tsc",
        "$esbuild"
      ]
    },
    {
      "type": "npm",
      "script": "build:tsc:watch",
      "label": "Build watch language service",
      "isBackground": true,
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "reveal": "never"
      },
      "problemMatcher": [
        "$ts-esbuild-watch",
        {
          "pattern": [
            {
              "regexp": "^([^\\\\s].*)\\\\((\\\\d+,\\\\d+)\\\\):\\\\s*(.*)$",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Compiler Starts",
            "endsPattern": "Compiler finished"
          }
        }
      ]
    }
  ]
}