{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "exactOptionalPropertyTypes": false,
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "declarationDir": "build/dts",
    "outDir": "build/esm",
    "resolvePackageJsonImports": true,
    "jsx": "preserve"
  },
  "include": ["src", "ts-exposed"],
  "exclude": ["build/**/*", "tests/fixtures"]
}
