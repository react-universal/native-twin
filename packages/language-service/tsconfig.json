{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "exactOptionalPropertyTypes": false,
    "moduleResolution": "bundler",
    "disableReferencedProjectLoad": true,
    "jsx": "preserve"
  },
  "include": [
    "src",
    "ts-exposed",
    "tests"
  ],
  "exclude": [
    "build/**/*",
    "tests/fixtures"
  ]
}