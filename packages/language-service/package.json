{
  "name": "@native-twin/language-service",
  "version": "7.0.0-next.3",
  "description": "Native Twin language server provider",
  "homepage": "https://github.com/react-universal/native-twin#readme",
  "bugs": {
    "url": "https://github.com/react-universal/native-twin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-universal/native-twin",
    "directory": "packages/language-server"
  },
  "license": "MIT",
  "author": "Cristhian Gutierrez",
  "exports": {
    ".": {
      "types": "./build/dts/index.d.ts",
      "import": "./build/esm/index.js",
      "default": "./build/cjs/index.js"
    },
    "./ts-adapter": {
      "types": "./build/dts/ts-adapter.d.ts",
      "import": "./build/esm/ts-adapter.js",
      "default": "./build/cjs/ts-adapter.js"
    },
    "./babel-adapter": {
      "types": "./build/dts/babel-adapter.d.ts",
      "import": "./build/esm/babel-adapter.js",
      "default": "./build/cjs/babel-adapter.js"
    }
  },
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/dts/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "extension",
    "build",
    "src",
    "browser"
  ],
  "scripts": {
    "build": "npx twin pack-dev",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:tsc:watch": "npx twin pack-dev -w",
    "build:watch": "npx twin pack-dev -w",
    "clean": "rm -rf build",
    "lint": "biome lint",
    "test": "yarn vitest --no-file-parallelism --test-timeout=0",
    "bench": "NODE_OPTIONS='--no-experimental-detect-module' VITE_CJS_IGNORE_WARNING=true npx vitest bench --no-isolate",
    "vscode:dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@ctrl/tinycolor": "^4.1.0",
    "@hediet/debug-visualizer-data-extraction": "^0.14.0",
    "@native-twin/arc-parser": "workspace:*",
    "@native-twin/core": "workspace:*",
    "@native-twin/css": "workspace:*",
    "@native-twin/helpers": "workspace:*",
    "@native-twin/preset-tailwind": "workspace:*",
    "code-block-writer": "^13.0.3",
    "cssbeautify": "0.3.1",
    "debug": "^4.4.3",
    "effect": "^3.19.3",
    "js-beautify": "^1.15.4",
    "ts-morph": "^27.0.2",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "^3.17.5"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "^7.23.3",
    "@babel/preset-typescript": "7.23.3",
    "@effect/language-service": "^0.54.0",
    "@types/debug": "^4.1.12",
    "@types/js-beautify": "^1",
    "esbuild-plugin-d.ts": "^1.3.0",
    "madge": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@native-twin/cli": "workspace:*",
    "vitest": "^4.0.15"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "nx": {
    "includedScripts": [
      "build",
      "build:watch",
      "clean",
      "esbuild:build",
      "lint",
      "vscode:dev"
    ]
  }
}
