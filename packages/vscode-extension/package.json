{
  "name": "native-twin-vscode",
  "displayName": "Native Twin LSP",
  "version": "1.0.0",
  "private": true,
  "description": "Native Twin vscode extension.",
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Visualization"
  ],
  "homepage": "https://github.com/react-universal/native-twin#readme",
  "bugs": {
    "url": "https://github.com/react-universal/native-twin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-universal/native-twin",
    "directory": "packages/vscode-extension"
  },
  "license": "MIT",
  "author": "Cristhian Gutierrez",
  "publisher": "native-twin",
  "main": "./build/cjs/extension.js",
  "browser": "./build/cjs/extension-web.js",
  "module": "./build/esm/extension.js",
  "scripts": {
    "build": "npx twin pack-dev",
    "build:web": "node ./esbuild.web.cjs",
    "build:tsc": "npx tsc -b",
    "build:tsc:watch": "npx tsc -p tsconfig.cjs.json --watch",
    "build:watch": "tsc -p tsconfig.cjs.json --watch",
    "esbuild:watch": "node ./esbuild.cjs --watch",
    "web:watch": "node ./esbuild.web.cjs --watch",
    "clean": "rm -rf build",
    "lint": "biome lint",
    "webpack:watch": "webpack --watch",
    "vsc-test": "vscode-test --watch",
    "chrome": "vscode-test-web --quality stable --coi --open-devtools --browserType=chromium --extensionDevelopmentPath=. ./project-fixture",
    "vsc:test": "sh ./scripts/e2e.sh",
    "vscode:dev": "tsc -b -w",
    "vscode:prepublish": "node ./esbuild.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "compile.file",
        "title": "Compile File",
        "icon": "$(refresh)",
        "category": "Native Twin"
      },
      {
        "command": "nativeTwin.restart",
        "title": "Restart IntelliSense",
        "category": "Native Twin",
        "icon": "$(refresh)"
      },
      {
        "command": "nativeTwin.openTwinRegion",
        "title": "Show File Region",
        "category": "Native Twin",
        "icon": "$(eye)"
      },
      {
        "command": "nativeTwin.workspaceInit",
        "title": "Setup Workspace",
        "category": "Native Twin",
        "icon": "$(play)"
      },
      {
        "command": "nativeTwin.createTwinFiles",
        "title": "Generate Native Twin files",
        "category": "Native Twin",
        "icon": "$(play)"
      }
    ],
    "configuration": [
      {
        "id": "nativeTwin",
        "title": "Native Twin Extension Configuration Settings",
        "type": "object",
        "properties": {
          "nativeTwin.functions": {
            "type": "array",
            "scope": "window",
            "title": "Function expressions to validate",
            "description": "List of template tags or functions to enable Native Twin intellisense in.",
            "items": {
              "type": "string",
              "description": "Function/Tag name."
            },
            "default": [
              "tw",
              "cx",
              "tx",
              "apply",
              "css",
              "variants",
              "styled",
              "style",
              "createVariants"
            ]
          },
          "nativeTwin.jsxAttributes": {
            "type": "array",
            "description": "List of html/jsx attributes to enable Native Twin intellisense in.",
            "scope": "window",
            "items": {
              "type": "string",
              "description": "JSX Attribute name."
            },
            "default": [
              "className",
              "class",
              "containerClassName"
            ]
          },
          "nativeTwin.debug": {
            "type": "boolean",
            "scope": "window",
            "description": "Enable/disable additional debug information.",
            "default": false
          },
          "nativeTwin.enable": {
            "type": "boolean",
            "scope": "window",
            "default": true,
            "markdownDescription": "Controls whether Native Twin intellisense is enabled or not."
          },
          "nativeTwin.format": {
            "scope": "window",
            "type": "boolean",
            "default": true,
            "description": "Enable/Disable Native twin format (based on precedence)"
          },
          "nativeTwin.trace.server": {
            "scope": "window",
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "description": "Traces the communication between VS Code and the language server."
          },
          "nativeTwin.completions": {
            "scope": "window",
            "type": "boolean",
            "default": true,
            "description": "Enable/Disable completions suggestions in native twin locations"
          },
          "nativeTwin.diagnostics": {
            "scope": "window",
            "type": "string",
            "enum": [
              "off",
              "info",
              "warn"
            ],
            "default": "off",
            "description": "Enable/Disable native-twin diagnostics and how they are reported"
          }
        }
      }
    ],
    "views": {
      "nativeTwin": [
        {
          "icon": "resources/icons/transparent/logo-alt-50.png",
          "id": "nativeTwin-files",
          "name": "Files"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nativeTwin",
          "title": "NativeTwin Dev Tools",
          "icon": "resources/icons/transparent/logo-alt-50.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nativeTwin-files",
        "contents": "Native Twin Dev Tools did not generate any file yet."
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "dependencies": {
    "@native-twin/compiler": "workspace:*",
    "@native-twin/helpers": "workspace:*",
    "@native-twin/language-server": "workspace:*",
    "@native-twin/language-service": "workspace:*",
    "@native-twin/ts-plugin": "workspace:*",
    "effect": "^3.19.3",
    "util": "^0.12.5",
    "vscode-languageclient": "^9.0.1",
    "vscode-uri": "^3.1.0",
    "vscode-url": "^0.0.2"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@types/vscode": "^1.106.1",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/test-web": "^0.0.77",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "path-browserify": "^1.0.1",
    "ts-loader": "^9.5.4",
    "vscode-test": "^1.6.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "optionalDependencies": {
    "@native-twin/cli": "workspace:*"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "icon": "resources/icons/transparent/logo-128.png",
  "extensionKind": [
    "ui",
    "workspace"
  ]
}
