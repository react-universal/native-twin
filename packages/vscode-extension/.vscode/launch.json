// A launch configuration that compiles the extension and then opens it inside a new window
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Launch Extension",
      "runtimeExecutable": "${execPath}",
      "autoAttachChildProcesses": true,
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      },
      "preLaunchTask": "vscode tsc watch",
      "args": [
        "--extensionDevelopmentPath=${workspaceRoot}",
        "--disable-extensions",
        "${workspaceFolder}/project-fixture"
      ],
      "env": {
        "NODE_NO_WARNINGS": "1"
      },
      "outFiles": [
        "${workspaceRoot}/build/**/*.js",
        "${workspaceRoot:}/build/**/*.js"
      ],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/../**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/build/cjs/test/index.js"
      ],
      "preLaunchTask": {
        "type": "npm",
        "script": "build:tsc:watch"
      },
      "outFiles": [
        "${workspaceFolder}/build/cjs/test/**/*.js"
      ]
    }
  ],
}