// A launch configuration that compiles the extension and then opens it inside a new window
{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Launch vs-code extension + TS plugin",
      "configurations": [
        "Launch Extension",
        "Attach to VS Code TS Server"
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Launch web extension",
      "debugWebviews": true,
      "debugWebWorkerHost": true,
      "enableContentValidation": true,
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions",
        "--extensionDevelopmentKind=web"
      ],
      "outFiles": [
        "${workspaceRoot}/build/**/*.js",
        "${workspaceRoot:}/build/**/*.js",
        "${workspaceRoot}/build/**/*.cjs",
        "${workspaceRoot:}/build/**/*.cjs",
        "${workspaceRoot}/build/**/*.mjs",
        "${workspaceRoot:}/build/**/*.mjs"
      ],
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 2
      },
      // "preLaunchTask": "webpack watch",
      // "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/../**",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Launch Extension",
      "runtimeExecutable": "${execPath}",
      "autoAttachChildProcesses": true,
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      },
      "args": [
        "--extensionDevelopmentPath=${workspaceRoot}",
        "--disable-extensions",
        "${workspaceFolder}/project-fixture"
      ],
      "env": {
        "NODE_NO_WARNINGS": "1"
      },
      "outFiles": [
        "${workspaceRoot}/build/**/*.js",
        "${workspaceRoot:}/build/**/*.js",
        "${workspaceRoot}/build/**/*.cjs",
        "${workspaceRoot:}/build/**/*.cjs",
        "${workspaceRoot}/build/**/*.mjs",
        "${workspaceRoot:}/build/**/*.mjs"
      ],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/../**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/build/test/index.cjs"
      ],
      "outFiles": [
        "${workspaceFolder}/build/test/**/*.cjs"
      ]
    }
  ],
}