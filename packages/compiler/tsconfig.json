{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "resolvePackageJsonExports": false,
    "stripInternal": true,
    "noImplicitOverride": false,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*",
    "test"
  ],
  "exclude": [
    "build",
    "test/fixtures"
  ]
}