{
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Test @lib/compiler",
      "program": "../../node_modules/.bin/vitest",
      "args": ["--watch", "project"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**/*.js",
        "node_modules",
      ]
    }
  ]
}