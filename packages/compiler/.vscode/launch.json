{
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Test @lib/compiler",
      "program": "../../node_modules/.bin/vitest",
      "args": [
        "--inspect-brk",
        "--no-file-parallelism",
        "--watch",
        "project"
      ],
      "env": {
        "VITE_CJS_IGNORE_WARNING": "true"
      },
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**/*.js",
        "node_modules",
      ]
    }
  ]
}