{
  "name": "@native-twin/helpers",
  "version": "7.0.0-next.3",
  "description": "Helpers for common utilities",
  "homepage": "https://github.com/react-universal/native-twin#readme",
  "bugs": {
    "url": "https://github.com/react-universal/native-twin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-universal/native-twin",
    "directory": "packages/helpers"
  },
  "license": "MIT",
  "author": "Cristhian Gutierrez",
  "exports": {
    ".": {
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    },
    "./fp": {
      "import": "./build/fp/index.mjs",
      "require": "./build/fp/index.cjs"
    },
    "./KeyMap": {
      "import": "./build/KeyMap.mjs",
      "require": "./build/KeyMap.cjs"
    },
    "./react": {
      "import": "./build/react.mjs",
      "require": "./build/react.cjs"
    },
    "./server": {
      "import": "./build/server.mjs",
      "require": "./build/server.cjs"
    },
    "./tree": {
      "import": "./build/tree.mjs",
      "require": "./build/tree.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.cts",
  "files": [
    "build",
    "src",
    "KeyMap",
    "react",
    "server",
    "tree",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsdown",
    "build:watch": "npx tsdown --watch",
    "clean": "rm -rf build",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "biome lint",
    "test": "npx vitest"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "nx": "^22.2.3"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "optionalDependencies": {
    "@native-twin/cli": "workspace:*",
    "jest": "~29.7.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "provenance": true
  },
  "effect": {
    "generateExports": {
      "include": [
        "*.ts"
      ]
    }
  },
  "gitHead": "4c26121d296e38153faa7dd196229db1a71e075d",
  "nx": {}
}
