{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "react-native"
    ],
    "exactOptionalPropertyTypes": false,
    "module": "nodenext",
    "noImplicitAny": false,
    "moduleResolution": "nodenext",
    "strict": true,
    "rootDir": "src"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "build"
  ]
}