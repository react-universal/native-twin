{
  "name": "@native-twin/styled",
  "version": "7.0.0-next.3",
  "description": "[DEPRECATED] Styled components for css in react native",
  "keywords": [
    "react-native",
    "tailwindcss",
    "tailwind-ui",
    "react-native-web",
    "universal-apps"
  ],
  "homepage": "https://github.com/react-universal/native-twin#readme",
  "bugs": {
    "url": "https://github.com/react-universal/native-twin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-universal/native-twin",
    "directory": "packages/styled"
  },
  "exports": {
    ".": {
      "types": "./build/dts/index.d.ts",
      "react-native": "./src/index.ts",
      "module": "./build/esm/index.js",
      "default": "./build/cjs/index.js"
    },
    "./components": {
      "source": "./src/components/index.ts",
      "import": {
        "default": "./build/cjs/components/index.js",
        "types": "./build/dts/components/index.d.ts"
      },
      "require": {
        "default": "./build/cjs/components/index.js",
        "types": "./build/dts/components/index.d.ts"
      }
    },
    "./components/*": {
      "source": "./src/components/*.tsx",
      "react-native": "./src/components/*.tsx",
      "import": {
        "types": "./build/dts/components/*.d.ts",
        "default": "./build/cjs/components/*.js"
      },
      "require": {
        "types": "./build/dts/components/*.d.ts",
        "default": "./build/cjs/components/*.js"
      }
    }
  },
  "license": "MIT",
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "react-native": "./src/index.ts",
  "types": "./build/dts/index.d.ts",
  "author": "Cristhian Gutierrez",
  "files": [
    "build",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "src",
    "styled"
  ],
  "scripts": {
    "build": "npx twin pack-dev",
    "build:watch": "npx twin pack-dev -w",
    "bundle": "yarn clean && yarn twin-build",
    "clean": "rm -rf build",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "biome lint",
    "test": "jest",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@native-twin/core": "workspace:*",
    "@native-twin/css": "workspace:*",
    "@native-twin/helpers": "workspace:*",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "react-is": "^18.2.0",
    "stable-hash": "0.0.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react-is": "^17.0.3"
  },
  "peerDependencies": {
    "@types/react": "~18.3.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.74.5",
    "react-native-web": "~0.19.10"
  },
  "optionalDependencies": {
    "jest": "~29.7.0"
  },
  "packageManager": "pnpm@9.14.2",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "gitHead": "4c26121d296e38153faa7dd196229db1a71e075d"
}