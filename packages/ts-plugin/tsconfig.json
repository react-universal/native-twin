{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declarationMap": false,
    "esModuleInterop": true,
    "strictFunctionTypes": false,
    "noImplicitAny": true,
    "lib": ["ESNext"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "strict": true,
    "target": "esnext",
    "composite": true
  },
  "include": ["src", "test", "ts-exposed"],
  "exclude": ["build", "old", "babel.config.js", "jest.config.js"]
}
