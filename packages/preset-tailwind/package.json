{
  "name": "@native-twin/preset-tailwind",
  "version": "7.0.0-next.3",
  "description": "Tailwindcss StyleSheet generator for react native/web",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "tailwind-native",
    "react-native-web",
    "universal-labs",
    "react-native",
    "react"
  ],
  "homepage": "https://github.com/react-universal/native-twin#readme",
  "bugs": {
    "url": "https://github.com/react-universal/native-twin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-universal/native-twin",
    "directory": "packages/preset-tailwind"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    },
    "./colors": {
      "import": "./build/colors.mjs",
      "require": "./build/colors.cjs"
    },
    "./default-config": {
      "import": "./build/default-config.mjs",
      "require": "./build/default-config.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.cts",
  "files": [
    "build",
    "colors",
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npx tsdown",
    "build:watch": "npx tsdown --watch",
    "clean": "rm -rf build",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "biome lint",
    "test": "jest",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@native-twin/core": "workspace:*",
    "@native-twin/css": "workspace:*",
    "@native-twin/helpers": "workspace:*"
  },
  "peerDependencies": {
    "react": "18.3.1"
  },
  "optionalDependencies": {
    "@native-twin/cli": "workspace:*",
    "jest": "~29.7.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "nx": {
    "includedScripts": [
      "build",
      "build:watch",
      "clean",
      "dev",
      "lint",
      "test:debug",
      "test:watch"
    ]
  }
}
