{
  "name": "@native-twin/jsx",
  "version": "7.0.0-next.3",
  "description": "Native Twin JSX runtime",
  "homepage": "https://github.com/react-universal/native-twin#readme",
  "bugs": {
    "url": "https://github.com/react-universal/native-twin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-universal/native-twin",
    "directory": "packages/jsx"
  },
  "license": "MIT",
  "author": "Cristhian Gutierrez",
  "exports": {
    ".": {
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    },
    "./components": {
      "import": "./build/components.mjs",
      "require": "./build/components.cjs"
    },
    "./components.web": {
      "import": "./build/components.web.mjs",
      "require": "./build/components.web.cjs"
    },
    "./index.web": {
      "import": "./build/index.web.mjs",
      "require": "./build/index.web.cjs"
    },
    "./jsx-dev-runtime": {
      "import": "./build/jsx-dev-runtime.mjs",
      "require": "./build/jsx-dev-runtime.cjs"
    },
    "./jsx-runtime": {
      "import": "./build/jsx-runtime.mjs",
      "require": "./build/jsx-runtime.cjs"
    },
    "./sheet": {
      "import": "./build/sheet/index.mjs",
      "require": "./build/sheet/index.cjs"
    },
    "./testing-library": {
      "import": "./build/testing-library/index.mjs",
      "require": "./build/testing-library/index.cjs"
    },
    "./testing-library/setup": {
      "import": "./build/testing-library/setup.mjs",
      "require": "./build/testing-library/setup.cjs"
    },
    "./testing-library/setupAfterEnv": {
      "import": "./build/testing-library/setupAfterEnv.mjs",
      "require": "./build/testing-library/setupAfterEnv.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.cts",
  "files": [
    "build",
    "jsx-dev-runtime",
    "jsx-runtime",
    "LICENSE",
    "sheet",
    "src",
    "testing-library",
    "rn-svg.d.ts",
    "third-party-declarations.d.ts",
    "types.d.ts",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "npx tsdown",
    "build:watch": "npx tsdown --watch",
    "clean": "rm -rf build",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "biome lint",
    "test": "jest",
    "test:debug": "node --inspect-brk ../../node_modules/.bin/jest --runInBand --silent false --watch",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@native-twin/core": "workspace:*",
    "@native-twin/css": "workspace:*",
    "@native-twin/helpers": "workspace:*",
    "@native-twin/preset-tailwind": "workspace:*",
    "its-fine": "^1.2.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.10"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-native-reanimated": "*"
  },
  "optionalDependencies": {
    "@jest/globals": "*",
    "@native-twin/cli": "workspace:*",
    "jest": "~29.7.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "effect": {
    "generateExports": {
      "include": [
        "*.ts"
      ]
    }
  }
}
