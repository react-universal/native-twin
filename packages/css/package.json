{
  "name": "@native-twin/css",
  "version": "7.0.0-next.3",
  "description": "Css parser for react native",
  "keywords": [
    "react-native",
    "tailwindcss",
    "react-native-web",
    "universal-apps",
    "react-native-css"
  ],
  "homepage": "https://github.com/react-universal/native-twin#readme",
  "bugs": {
    "url": "https://github.com/react-universal/native-twin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-universal/native-twin",
    "directory": "packages/css"
  },
  "license": "MIT",
  "author": "Cristhian Gutierrez",
  "exports": {
    ".": {
      "import": "./build/index.mjs",
      "require": "./build/index.cjs"
    },
    "./jsx": {
      "import": "./build/jsx/index.mjs",
      "require": "./build/jsx/index.cjs"
    },
    "./react-native": {
      "import": "./build/react-native/index.mjs",
      "require": "./build/react-native/index.cjs"
    },
    "./twin-parser": {
      "import": "./build/twin-parser.mjs",
      "require": "./build/twin-parser.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "react-native": "./build/esm/index.js",
  "types": "./build/index.d.cts",
  "files": [
    "build",
    "LICENSE",
    "CHANGELOG.md",
    "parser",
    "src",
    "jsx",
    "README.md",
    "tailwind-parser"
  ],
  "scripts": {
    "build": "npx tsdown",
    "build:watch": "npx tsdown --watch",
    "clean": "rm -rf build",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "docgen": "docgen",
    "lint": "biome lint",
    "test": "vitest",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@native-twin/arc-parser": "workspace:*",
    "@native-twin/helpers": "workspace:*"
  },
  "devDependencies": {
    "fp-ts": "^2.16.9"
  },
  "optionalDependencies": {
    "@native-twin/cli": "workspace:*",
    "jest": "~29.7.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "gitHead": "4c26121d296e38153faa7dd196229db1a71e075d"
}
