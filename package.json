{
  "name": "native-twin",
  "version": "0.0.0-development",
  "private": true,
  "homepage": "https://github.com/react-universal/native-twin#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/react-universal/native-twin.git"
  },
  "license": "MIT",
  "author": "Cristhian Gutierrez",
  "workspaces": [
    "packages/*",
    "packages/dev-tools/webui",
    "sites/twin.run",
    "!packages/ts-plugin/typescript-internals",
    "apps/*"
  ],
  "resolutions": {
    "react-native-worklets": "0.6.1",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@^23.2.2"
  },
  "scripts": {
    "build": "yarn && npx turbo run build",
    "build:release": "npx turbo run build && yarn libs:foreach pack && yarn libs:foreach exec \"mkdir _release && tar zxvf package.tgz --directory _release && rm package.tgz\"",
    "clean": "node ./scripts/clean.mjs",
    "docgen": "yarn libs:foreach exec npx docgen && node ./scripts/docs.mjs",
    "docs:build": "turbo run docs:build",
    "example:expo": "yarn workspace expo-app run start",
    "extension:dev": "turbo run vscode:dev",
    "format": "prettier --write packages apps examples \"**/*.{js,ts,tsx,md}\"",
    "libs:foreach": "yarn workspaces foreach --all --no-private --verbose",
    "lint": "turbo run lint",
    "nextjs:pages:dev": "turbo run nextjs:pages:dev",
    "release": "yarn build:release && changeset publish",
    "test": "turbo run test",
    "check-deps": "knip --config ./knip.json"
  },
  "dependencies": {
    "effect": "^3.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "vitest": "^3.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.25.2",
    "@biomejs/biome": "^2.2.6",
    "@changesets/changelog-git": "^0.2.0",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.9",
    "@effect/build-utils": "^0.8.9",
    "@effect/experimental": "^0.57.1",
    "@effect/language-service": "^0.54.0",
    "@effect/vitest": "^0.26.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/chai": "4.3.5",
    "@types/glob": "^8.1.0",
    "@types/jest": "29.5.14",
    "@types/mocha": "^10.0.1",
    "@types/node": "^24.9.0",
    "@types/react-test-renderer": "^18.0.0",
    "@types/webpack": "^5.28.5",
    "@vitest/browser": "^3.0.6",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "babel-plugin-annotate-pure-calls": "^0.4.0",
    "chai": "4.3.7",
    "concurrently": "^7.6.0",
    "glob": "^11.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.13",
    "knip": "^5.66.2",
    "lightningcss": "^1.28.2",
    "metro-react-native-babel-preset": "^0.77.0",
    "mocha": "^10.2.0",
    "react-native-worklets": "0.6.1",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-unused-exports": "^11.0.1",
    "tslib": "^2.8.1",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.6.0",
  "volta": {
    "node": "20.18.2"
  }
}
