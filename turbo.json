{
  "$schema": "node_modules/turbo/schema.json",
  "ui": "tui",
  "concurrency": "12",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/test/**",
        "!**/tests/**",
        "!**/tsconfig.*",
        "src/**"
      ],
      "outputs": [
        "build/**",
        "dist/**"
      ]
    },
    "build:watch": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "cache": true
    },
    "clean": {
      "cache": false
    },
    "next:app:dev": {
      "cache": false,
      "interactive": true,
      "outputLogs": "full",
      "persistent": true,
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "build/**"
      ]
    },
    "docs:dev": {
      "cache": false,
      "interactive": true,
      "outputLogs": "full",
      "persistent": true,
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "build/**"
      ]
    },
    "test": {
      "cache": true
    },
    "gen:jsdocs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/test",
        "!**/tests",
        "**/webui/**/*",
        "**/src",
        "jsdoc.json"
      ],
      "cache": true
    }
  }
}