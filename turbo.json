{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/test",
        "!**/tests",
        "!**/tsconfig.*",
        "src/**"
      ],
      "outputs": [
        "build/**",
        "dist/**"
      ]
    },
    "build:watch": {
      "dependsOn": [],
      "persistent": true,
      "cache": false
    },
    "build:compiler": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/test",
        "!**/tests",
        "!**/tsconfig.*"
      ],
      "outputs": [
        "build/**",
        "dist/**"
      ]
    },
    "dev-tools:dev": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/test",
        "!**/tests",
        "**/webui/**/*"
      ],
      "outputs": [
        "build/**",
        "dist/**"
      ]
    },
    "lint": {
      "cache": true
    },
    "clean": {
      "cache": false
    },
    "next:app:dev": {
      "cache": false,
      "interactive": true,
      "outputLogs": "full",
      "persistent": true,
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "build/**"
      ]
    },
    "docs:dev": {
      "cache": false,
      "interactive": true,
      "outputLogs": "full",
      "persistent": true,
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "build/**"
      ]
    },
    "test": {
      "cache": true
    },
    "gen:jsdocs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/test",
        "!**/tests",
        "**/webui/**/*",
        "**/src",
        "jsdoc.json"
      ],
      "cache": true
    }
  }
}